			},
			{
				"name": "\"order_item_id\"",
				"type": "UTF8"
			},
			{
				"name": "\"product_id\"",
				"type": "UTF8"
			},
			{
				"name": "\"seller_id\"",
				"type": "UTF8"
			},
			{
				"name": "\"shipping_limit_date\"",
				"type": "UTF8"
			},
			{
				"name": "\"price\"",
				"type": "UTF8"
			},
			{
				"name": "\"freight_value\"",
				"type": "UTF8"
			}
		]
	}
}